APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000
BIND_HOST=127.0.0.1
SESSION_SECRET=replace-with-at-least-32-random-characters
OPERATOR_PASSWORD=replace-operator-password
REVIEWER_PASSWORD=replace-reviewer-password
AUTO_SEED=true
AUTH_DISABLED=false
COOKIE_SECURE=false
MAX_UPLOAD_MB=10
DATABASE_PATH=/app/runtime/employment_ai.db
SEED_XLSX=/app/data/synthetic/employment_ai_demo.xlsx
ONTOLOGY_PATH=/app/data/ontology/employment_ontology.json
DISABLED_PLUGINS=
